<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exemplo da escolha do cofre pela configuração: o mesmo binário usa o provedor em memória em Development, arquivos montados
    (provedor Directory) em Staging e o HashiCorp Vault em Production, só trocando o appsettings.{Ambiente}.json.
    Uso em samples/README.md. Não é publicado: framework, lock file e auditoria de pacotes em ../../Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TEC.Vault.ConfigSelection</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TEC.Vault\TEC.Vault.csproj" />
    <ProjectReference Include="..\..\TEC.Vault.AzureKeyVault\TEC.Vault.AzureKeyVault.csproj" />
    <ProjectReference Include="..\..\TEC.Vault.HashiCorpVault\TEC.Vault.HashiCorpVault.csproj" />
    <ProjectReference Include="..\..\TEC.Vault.Infisical\TEC.Vault.Infisical.csproj" />
    <ProjectReference Include="..\..\TEC.Vault.InMemory\TEC.Vault.InMemory.csproj" />
    <ProjectReference Include="..\..\TEC.Vault.Synced\TEC.Vault.Synced.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="segredos-exemplo\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
