<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gerador de carga próprio (sem licença nem binário externo, mesmo padrão do TEC.Core.LoadGenerator) para os provedores do
    TEC.Vault: em memória, Azure Key Vault simulado em HTTP (SDK real, sem rede) e o Key Vault de testes (opcional).
    Uso e opções da linha de comando em samples/README.md.
    Também é referenciado pelos testes de carga (TEC.Vault.LoadTests), que usam a classe LoadRunner em processo.
    Não é publicado: framework, lock file e auditoria de pacotes em ../../Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TEC.Vault.LoadGenerator</RootNamespace>
    <!-- CA5394: Random só sorteia carga, entradas de fuzz e latência simulada (reprodutível por semente); nada de segurança depende dele -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TEC.Vault\TEC.Vault.csproj" />
    <ProjectReference Include="..\..\TEC.Vault.AzureKeyVault\TEC.Vault.AzureKeyVault.csproj" />
    <ProjectReference Include="..\..\TEC.Vault.InMemory\TEC.Vault.InMemory.csproj" />
  </ItemGroup>

  <!-- Os testes de carga leem o cache interno (CachingSecretReader) do alvo -->
  <ItemGroup>
    <InternalsVisibleTo Include="TEC.Vault.LoadTests" />
  </ItemGroup>

</Project>
