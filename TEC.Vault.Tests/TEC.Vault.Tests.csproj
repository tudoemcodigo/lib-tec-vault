<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Mesmo id em todos os projetos de teste dos componentes TEC: um único "dotnet user-secrets set" vale para todos -->
    <UserSecretsId>tudoemcodigo-tec-testes</UserSecretsId>
    <!-- CA5394: Random só sorteia carga, entradas de fuzz e latência simulada (reprodutível por semente); nada de segurança depende dele -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!--
    Configuração dos testes de integração na máquina do desenvolvedor (ver Integration\TestSettings.cs): variáveis de
    ambiente, user-secrets ou appsettings.Local.json (seção TecTestes; arquivo ignorado pelo git, copiado para a saída).
  -->
  <ItemGroup>
    <None Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Vault.AzureKeyVault\TEC.Vault.AzureKeyVault.csproj" />
    <ProjectReference Include="..\TEC.Vault.HashiCorpVault\TEC.Vault.HashiCorpVault.csproj" />
    <ProjectReference Include="..\TEC.Vault.Infisical\TEC.Vault.Infisical.csproj" />
    <ProjectReference Include="..\TEC.Vault.InMemory\TEC.Vault.InMemory.csproj" />
    <ProjectReference Include="..\TEC.Vault.Synced\TEC.Vault.Synced.csproj" />
    <ProjectReference Include="..\TEC.Vault\TEC.Vault.csproj" />
  </ItemGroup>

</Project>
