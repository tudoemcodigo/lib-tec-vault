<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Vault.HashiCorpVault</RootNamespace>
    <Description>Conecta o TEC.Vault ao HashiCorp Vault (e OpenBao) pela API HTTP, sem SDK de terceiros: segredos no KV v2 com lixeira, chaves no Transit (criptografia e assinatura sem a chave sair do cofre) e certificados emitidos pelo PKI, com login por Kubernetes, JWT/OIDC, AppRole ou token, compatível com Native AOT.</Description>
    <PackageTags>vault;secrets;hashicorp;openbao;transit;pki;zero-trust;tec</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Vault\TEC.Vault.csproj" />
  </ItemGroup>

</Project>
