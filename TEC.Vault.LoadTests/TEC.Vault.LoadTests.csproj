<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes de carga e de performance (TUnit), com o gerador de carga próprio (samples/TEC.Vault.LoadGenerator) em processo.
    Seleção por categoria: Carga-CI (segundos, em todo pull request) e Carga-Pesada (performance.yml e release; duração
    multiplicada por TEC_CARGA_FATOR, relatórios .md na pasta TEC_CARGA_RELATORIOS). O cenário contra o Key Vault de testes
    real também é Carga-Pesada e se pula sem TEC_TESTES_VAULT_URI.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Mesmo id em todos os projetos de teste dos componentes TEC: um único "dotnet user-secrets set" vale para todos -->
    <UserSecretsId>tudoemcodigo-tec-testes</UserSecretsId>
    <!-- CA5394: Random só sorteia carga, entradas de fuzz e latência simulada (reprodutível por semente); nada de segurança depende dele -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!-- Mesma leitura de configuração dos testes de integração (variáveis TEC_TESTES_*, user-secrets, appsettings.Local.json) -->
  <ItemGroup>
    <Compile Include="..\TEC.Vault.Tests\Integration\TestSettings.cs" Link="Integration\TestSettings.cs" />
    <None Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\samples\TEC.Vault.LoadGenerator\TEC.Vault.LoadGenerator.csproj" />
  </ItemGroup>

</Project>
