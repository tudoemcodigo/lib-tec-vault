<?xml version="1.0" encoding="utf-8"?>
<!--
  ARQUIVO CANÔNICO: mantido em tudoemcodigo/tec-workflows (template). Não edite no componente:
  altere no tec-workflows e rode scripts/sync-template.sh. O CI (job "Convenções") falha se a cópia divergir.
-->
<configuration>
  <!--
    Origens fixas do repositório. As credenciais do tec-interno (GitHub Packages exige token até para pacote público)
    ficam FORA daqui: no NuGet.Config do usuário ou do CI, na origem de mesmo nome. Nunca coloque credenciais neste arquivo.
      dotnet nuget add source https://nuget.pkg.github.com/tudoemcodigo/index.json -n tec-interno -u <usuario-github> -p <PAT read:packages>
    (no Windows a senha fica criptografada no NuGet.Config do usuário; no Linux/macOS acrescente store-password-in-clear-text)
    Com os repositórios vizinhos clonados, o modo local (build/Tec.Build.targets) nem consulta o tec-interno.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="tec-interno" value="https://nuget.pkg.github.com/tudoemcodigo/index.json" />
  </packageSources>

  <!-- Dependency confusion: cada pacote só pode vir da origem mapeada (TEC.* exclusivamente do feed interno) -->
  <packageSourceMapping>
    <packageSource key="tec-interno">
      <package pattern="TEC.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
