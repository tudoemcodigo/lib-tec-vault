<Project Sdk="Microsoft.NET.Sdk">

  <!-- Configurações de build, segurança e metadados comuns: ..\Directory.Build.props -->

  <PropertyGroup>
    <RootNamespace>TEC.Vault.Infisical</RootNamespace>
    <Description>Conecta o TEC.Vault ao Infisical (nuvem ou self-hosted) pela API REST, sem SDK de terceiros: leitura e gravação de segredos com identidade de máquina (Universal Auth ou Kubernetes Auth), compatível com Native AOT.</Description>
    <PackageTags>vault;secrets;infisical;zero-trust;tec</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TEC.Vault\TEC.Vault.csproj" />
  </ItemGroup>

</Project>
